{
    "env": {
        "global.dataset.sources.*.alphavantage.apikey": "ALPHAVANTAGE_APIKEY"
    },

    "global": {
        "dataset": {
            "sources": {
                "*": {
                    "alphavantage": {
                        "datatype": "csv"
                    }
                }
            },

            "scale_real_columns": [ ],
            "scale_categorical_columns": [ ],
            "embed_integer_columns": [ ],

            "test_split": 0.1,
            "validation_split": 0.2,
            "batch_size": 64
        },
        "model": {
            "epochs": 4,
            
            "hidden_layer_size": 128,
            "dropout_rate": 0.2,
                
            "deepspeed": {
                "gradient_accumulation_steps": 1,
                "optimizer": {
                    "type": "Adam",
                    "params": {
                      "lr": 0.001,
                      "betas": [
                        0.8,
                        0.999
                      ],
                      "eps": 1e-8,
                      "weight_decay": 3e-7
                    }
                },
                "scheduler": {
                    "type": "WarmupLR",
                    "params": {
                        "warmup_min_lr": 0.00001,
                        "warmup_max_lr": 0.001,
                        "warmup_num_steps": 25000
                    }
                },
                "comms_logger": {
                    "enabled": false,
                    "verbose": false,
                    "prof_all": false,
                    "debug": false
                },
                "zero_optimization": true,
                "steps_per_print": 250
            }
        }
    },

    "runs": {
        "Intra-LSTM-TQQQ": {
            "neptune": {
                "name": "Intra-LSTM",
                "with_id": "STOC-1",
                "tags": [ "Intraday", "LSTM", "Stock" ]
            },

            "dataset": {
                "sources": {
                    "tqqq": {
                        "source_class": "AlphaVantageSource",
                        "symbol": "TQQQ",
                        "interval": "1min",
                        "column_flags": "TIMESTAMP & OHLCV & SEM_PRICE",
                        "generate_intervals": true,

                        "alphavantage": {
                            "symbol": "TQQQ",
                            "interval": "1min",
                            "function": "TIME_SERIES_INTRADAY",
                            "month": "-8",
                            "outputsize": "full",
                            "extended_hours": true,
                            "adjusted": true
                        }
                    },
                    "vxx": {
                        "source_class": "AlphaVantageSource",
                        "symbol": "VXX",
                        "interval": "1min",
                        "column_flags": "TIMESTAMP & OHLC & SEM_VOLATILITY",
                        "generate_intervals": true,

                        "alphavantage": {
                            "symbol": "VXX",
                            "interval": "1min",
                            "function": "TIME_SERIES_INTRADAY",
                            "month": "-8",
                            "outputsize": "full",
                            "extended_hours": true,
                            "adjusted": true
                        }
                    },
                    "tech-news": {
                        "source_class": "AlphaVantageSource",
                        "symbol": "tech-news",
                        "interval": "variable",
                        "column_flags": "TIMESTAMP & SEM_NEWS",

                        "function": "NEWS_SENTIMENT",
                        "topics": "technology",
                        "limit": 1000,
                        "sort": "LATEST",

                        "indicators": []
                    }
                },
                "resample_intervals": [
                    "1min", "5min", "15min", "30min",
                    "1hr", "4hr", "1d", "4d", "1w" 
                ],
                "indicators": [
                    {
                        "function": "TA.EMA",
                        "is_scaled": true,
                        "offset": 9,
                        "params": { "period": 9 }
                    },
                    {
                        "function": "TA.EMA",
                        "is_scaled": true,
                        "offset": 20,
                        "params": { "period": 20 }
                    },
                    {
                        "function": "TA.MACD",
                        "is_scaled": true,
                        "offset": 26,
                        "params": {
                            "period_fast": 26,
                            "period_slow": 12
                        }
                    },
                    {
                        "function": "np.diff(close)",
                        "name": "delta",
                        "offset": 1
                    },
                    {
                        "function": "np.log(volume)",
                        "name": "log_vol"
                    }
                ],
                "include_columns": [
                    { "name": "open", "is_scaled": true },
                    { "name": "high", "is_scaled": true },
                    { "name": "low", "is_scaled": true },
                    { "name": "close", "is_scaled": true },
                    { "name": "dt_hour" },
                    { "name": "dt_minute" }
                ],

                "target": "close_delta"
            },

            "model_name": "SimpleLSTM",
            "model": {
                "epochs": 4,

                "seq_len": 144,
                "out_seq_len": 4,
            
                "hidden_layer_size": 256
            },

            "trader_name": "StandardTrader",
            "trader": {
                "episodes": 256,
                "hidden_layer_size": 2048
            }
        },
        "Intra-Ext-LSTM-TQQQ": {
            "copy_run": "Intra-LSTM-TQQQ",
            "dataset": {
                "alphavantage": {
                    "months": "-24"
                }
            }
        },
        "Intra-GMLP-TQQQ": {
            "copy_run": "Intra-LSTM-TQQQ",
            "model_name": "GatedMLP",
            "model": {
                "hidden_layer_size": 256,
                "dropout_rate": 0.0,
                "learning_rate": 0.01,

                "seq_len": 144,
                "out_seq_len": 4,

                "precompile": false,
                "pin_memory": true,

                "gmlp": {
                    "embedding_length": 32,
                    "layer_count": 6
                }
            },
            "trader": {
                "episodes": 0,
                "hidden_layer_size": 2048
            }
        },
        "Intra-GMLP-MADL-TQQQ": {
            "copy_run": "Intra-GMLP-TQQQ",
            "model": {
                "loss": "mse + madl"
            }
        },
        "Intra-GMLP-Testing-TQQQ": {
            "copy_run": "Intra-GMLP-TQQQ",
            "model": {
                "epochs": 1
            }
        },
        "Intra-GCNN-TQQQ": {
            "copy_run": "Intra-GMLP-TQQQ",
            "model_name": "GatedCNN",
            "model": {
                "epochs": 8
            },
            "gmlp": {
                "embedding_length": 48,
                "layer_count": 4
            }
        },
        "Intra-GCNN-Testing-TQQQ": {
            "copy_run": "Intra-GMLP-TQQQ",
            "model_name": "GatedCNN",
            "model": {
                "epochs": 1
            }
        },
        "Intra-Ext-GMLP-TQQQ": {
            "copy_run": "Intra-Ext-LSTM-TQQQ",
            "model_name": "GatedMLP",
            "model": {
                "epochs": 12,
                "hidden_layer_size": 128,
                "gmlp": {
                    "embedding_length": 128,
                    "layer_count": 8
                }
            }
        },

        "Daily-LSTM-TQQQ": {
            "neptune": {
                "name": "Daily-LSTM",
                "with_id": "STOC-1",
                "tags": [ "Intraday", "LSTM", "Stock" ]
            },

            "dataset_name": "alphavantage",
            "dataset": {
                "alphavantage": {
                    "symbol": "TQQQ",

                    "function": "TIME_SERIES_DAILY_ADJUSTED",
                    "outputsize": "full"
                },
                "indicators": [
                    {
                        "function": "EMA",
                        "period": 20,
                        "is_input": true,
                        "is_scaled": true
                    },
                    {
                        "function": "MACD",
                        "period": 26,
                        "period2": 12,
                        "is_input": true,
                        "is_scaled": true
                    },
                    {
                        "function": "delta_close",
                        "is_input": true
                    },
                    {
                        "function": "log_vol",
                        "is_input": true
                    }
                ],
                "columns": [
                    { "name": "close", "is_scaled": true },
                    { "name": "dt_hour", "is_scaled": true }
                ]
            },

            "model_name": "SimpleLSTM",
            "model": {
                "epochs": 8,
                "seq_len": 72,
                "out_seq_len": 1,
            
                "hidden_layer_size": 256
            },

            "trader_name": "StandardTrader",
            "trader": {
                "episodes": 256,
                "hidden_layer_size": 2048
            }
        }
    }
}